end

post_install do |installer|
  # Lynx 3.9.0 uses GNU array designators; Xcode 26.4 promotes this diagnostic.
  installer.pods_project.targets.select { |target| target.name == 'Lynx' }.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['WARNING_CFLAGS'] = ['$(inherited)', '-Wno-error=c99-designator']
    end
  end
end
