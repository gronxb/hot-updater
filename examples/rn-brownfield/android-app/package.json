{
  "name": "@examples/rn-brownfield-android-app",
  "version": "0.0.1",
  "private": true,
  "description": "Native Android host that embeds the rnbrownfieldreact AAR published by ../rn-app to the local Maven repository.",
  "scripts": {
    "build": "./gradlew :app:assembleRelease",
    "uninstall": "adb uninstall com.hotupdater.brownfieldhost || true",
    "install:release": "./gradlew :app:installRelease",
    "launch": "adb shell monkey -p com.hotupdater.brownfieldhost -c android.intent.category.LAUNCHER 1",
    "android": "pnpm install:release && pnpm launch"
  }
}
