{
  "name": "@examples/rn-brownfield-react-native",
  "version": "0.0.1",
  "private": true,
  "description": "React Native app packaged as an AAR and an XCFramework for the native hosts in ../android and ../ios.",
  "scripts": {
    "start": "rock start",
    "lint": "eslint .",
    "ios": "rock run:ios",
    "android": "rock run:android",
    "package:ios": "rock package:ios --scheme RnBrownfieldReact --configuration Release",
    "package:aar": "rock package:aar --variant Release --module-name rnbrownfieldreact",
    "publish-local:aar": "pnpm package:aar && rock publish-local:aar --module-name rnbrownfieldreact"
  },
  "dependencies": {
    "@callstack/react-native-brownfield": "5.3.0",
    "react": "19.2.0",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@rock-js/platform-android": "0.15.2",
    "@rock-js/platform-ios": "0.15.2",
    "@rock-js/plugin-brownfield-android": "0.15.2",
    "@rock-js/plugin-brownfield-ios": "0.15.2",
    "@rock-js/plugin-metro": "0.15.2",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "hermes-compiler": "250829098.0.14",
    "prettier": "2.8.8",
    "rock": "0.15.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
