# Copy to .env.hotupdater (gitignored), or let `npx hot-updater init` write it.
#
# Read by hot-updater.config.ts (CLI only, never bundled):
HOT_UPDATER_SUPABASE_URL=https://<your-project-id>.supabase.co
HOT_UPDATER_SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
HOT_UPDATER_SUPABASE_BUCKET_NAME=<your-bucket-name>
#
# Inlined into the JS bundle by hot-updater-build-config.cjs (public settings):
HOT_UPDATER_APP_BASE_URL=https://<your-project-id>.supabase.co/functions/v1/hot-updater-v1
HOT_UPDATER_API_KEY=<YOUR_HOT_UPDATER_CLIENT_API_KEY>
