{
  "name": "@hot-updater/root",
  "private": true,
  "description": "React Native OTA solution for self-hosted",
  "keywords": [],
  "license": "MIT",
  "scripts": {
    "lint:fix": "oxfmt --write \"packages/**/*.{ts,tsx}\" \"plugins/**/*.{ts,tsx}\" \"docs/**/*.{ts,tsx}\" && oxlint --fix --fix-suggestions --fix-dangerously packages plugins docs",
    "lint": "oxfmt --check \"packages/**/*.{ts,tsx}\" \"plugins/**/*.{ts,tsx}\" \"docs/**/*.{ts,tsx}\" && oxlint packages plugins docs && node scripts/ci/check-package-boundaries.mjs",
    "lint:design": "pnpm dlx oxlint@1.80.0 --config .oxlintrc.shadcn.json packages/console/src",
    "clear": "rimraf --glob **/dist .nx",
    "test": "vitest run --project=\"unit:*\"",
    "test:integration": "vitest run --project=\"integration:*\"",
    "test:swift": "swift test --package-path packages/react-native/ios/HotUpdater",
    "acceptance": "node scripts/acceptance/report.mts",
    "bench": "node ./scripts/bench.mjs",
    "bench:update-check": "node ./scripts/bench.mjs packages/server/src/db/updateCheck.bench.ts",
    "build": "nx run-many --target=build --projects=packages/*,plugins/*,docs",
    "fingerprint:create": "nx run-many --target='fingerprint:create' --projects=examples/*",
    "e2e": "node --experimental-strip-types ./e2e/run.ts",
    "e2e:build": "node --experimental-strip-types ./e2e/mobile/build.ts",
    "e2e:test:type": "tsc --project e2e/mobile/tsconfig.json",
    "test:type": "nx run-many --target=test:type --projects=packages/*,plugins/*,docs,examples-server/* && pnpm -w e2e:test:type",
    "release:test": "nx release --dry-run",
    "release": "pnpm clear && pnpm build && nx release --skip-publish",
    "publish:all": "nx release publish",
    "publish:rc": "nx release publish --tag rc",
    "changeset": "changeset",
    "changeset:minor": "node ./scripts/changeset-minor.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/plugin-transform-modules-commonjs": "7.25.9",
    "@babel/preset-typescript": "7.28.5",
    "@changesets/cli": "^3.0.1",
    "@cloudflare/vitest-pool-workers": "0.13.0",
    "@e2e-dev/mobile": "0.9.1",
    "@hono/node-server": "catalog:hono",
    "@nx/js": "22.6.3",
    "@shadcn/lint": "^0.1.1",
    "@swc/helpers": "^0.5.17",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "agent-device": "0.21.18",
    "bun": "1.3.13",
    "deno-bin": "2.2.7",
    "e2e": "0.16.0",
    "execa": "catalog:tools",
    "hono": "catalog:hono",
    "nx": "22.6.3",
    "oxc-parser": "0.141.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "rimraf": "^5.0.7",
    "tsdown": "catalog:tools",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.6.0"
}
