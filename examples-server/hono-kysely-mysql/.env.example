# Server Configuration
PORT=3000
HOT_UPDATER_AUTH_TOKEN=replace-with-a-secret

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=hot_updater
MYSQL_PASSWORD=hot_updater_dev
MYSQL_DATABASE=hot_updater

# Copy this file to src/.env.hotupdater.

# Cloudflare R2 through the S3-compatible API (optional)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
