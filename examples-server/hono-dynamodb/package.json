{
  "name": "@examples-server/hono-dynamodb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "e2e:bootstrap-api-key": "tsx scripts/e2e-bootstrap-api-key.ts",
    "e2e:cleanup": "bash scripts/e2e-cleanup.sh",
    "e2e:service": "bash scripts/e2e-service.sh",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:type": "tsc --noEmit",
    "docker:up": "docker compose up -d --remove-orphans",
    "docker:down": "docker compose down -v --remove-orphans"
  },
  "dependencies": {
    "@hono/node-server": "catalog:hono",
    "@hot-updater/aws": "workspace:*",
    "@hot-updater/mock": "workspace:*",
    "@hot-updater/server": "workspace:*",
    "dotenv": "^16.6.1",
    "hono": "catalog:hono"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1066.0",
    "@aws-sdk/client-s3": "catalog:aws",
    "@aws-sdk/lib-dynamodb": "3.1066.0",
    "@hot-updater/core": "workspace:*",
    "@hot-updater/plugin-core": "workspace:*",
    "@hot-updater/standalone": "workspace:*",
    "@hot-updater/test-utils": "workspace:*",
    "@types/node": "^20.11.17",
    "execa": "catalog:tools",
    "tsx": "^4.20.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
