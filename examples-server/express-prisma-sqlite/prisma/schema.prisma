// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User's custom models
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- BEGIN HOT-UPDATER MODELS (DO NOT EDIT) ---
model channels {
  id String @id
  name String
  releases releases[] @relation("releases_channels")
  releaseCatalogs release_catalogs[] @relation("release_catalogs_channels")
  @@unique([name], map: "channels_name_key")
}
model bundles {
  id String @id
  platform String
  file_hash String
  git_commit_hash String?
  storage_uri String
  metadata Json
  manifest_storage_uri String?
  manifest_file_hash String?
  asset_base_storage_uri String?
  patches bundle_patches[] @relation("bundle_patches_bundles_patches")
  baseForPatches bundle_patches[] @relation("bundle_patches_bundles_baseForPatches")
  releases releases[] @relation("releases_bundles")
}
model bundle_patches {
  id String @id
  bundle_id String
  base_bundle_id String
  base_file_hash String
  patch_file_hash String
  patch_storage_uri String
  order_index Int @default(0)
  bundle bundles @relation("bundle_patches_bundles_patches", fields: [bundle_id], references: [id], onUpdate: Restrict, onDelete: Cascade)
  baseBundle bundles @relation("bundle_patches_bundles_baseForPatches", fields: [base_bundle_id], references: [id], onUpdate: Restrict, onDelete: Cascade)
  @@index([bundle_id], map: "bundle_patches_bundle_id_idx")
  @@index([base_bundle_id], map: "bundle_patches_base_bundle_id_idx")
}
model releases {
  id String @id
  revision Int
  scope_key String
  channel_id String
  platform String
  kind String
  bundle_id String?
  strategy String
  target_app_version String?
  fingerprint_hash String?
  enabled Boolean
  should_force_update Boolean
  message String?
  rollout_cohort_count Int @default(1000)
  target_cohorts Json
  operation String
  source_release_id String?
  created_at_ms Float
  updated_at_ms Float
  derivedReleases releases[] @relation("releases_source_release")
  channelRecord channels @relation("releases_channels", fields: [channel_id], references: [id], onUpdate: Restrict, onDelete: Restrict)
  bundle bundles? @relation("releases_bundles", fields: [bundle_id], references: [id], onUpdate: Restrict, onDelete: Restrict)
  sourceRelease releases? @relation("releases_source_release", fields: [source_release_id], references: [id], onUpdate: Restrict, onDelete: SetNull)
  @@index([scope_key, id], map: "releases_scope_order_idx")
  @@index([channel_id, platform, id], map: "releases_channel_platform_order_idx")
  @@index([bundle_id], map: "releases_bundle_id_idx")
  @@index([fingerprint_hash], map: "releases_fingerprint_hash_idx")
  @@index([enabled], map: "releases_enabled_idx")
}
model release_catalogs {
  scope_key String @id
  authority_id String
  strategy String
  channel_id String
  channel_key String
  platform String
  fingerprint_hash String?
  generation Float
  payload String
  catalog_hash String
  byte_size Int
  is_tombstone Boolean
  updated_at_ms Float
  channelRecord channels @relation("release_catalogs_channels", fields: [channel_id], references: [id], onUpdate: Restrict, onDelete: Restrict)
  @@index([channel_id], map: "release_catalogs_channel_idx")
  @@index([authority_id, strategy], map: "release_catalogs_authority_strategy_idx")
}
model bundle_events {
  id String @id
  type String
  install_id String
  user_id String?
  username String?
  from_release_id String?
  from_bundle_id String?
  to_release_id String?
  to_bundle_id String
  platform String
  app_version String
  channel String
  cohort String
  update_strategy String?
  fingerprint_hash String?
  sdk_version String?
  received_at_ms Float
  @@index([received_at_ms, id], map: "bundle_events_received_at_idx")
  @@index([install_id, received_at_ms, id], map: "bundle_events_install_idx")
  @@index([user_id, received_at_ms, id], map: "bundle_events_user_id_idx")
  @@index([username, received_at_ms, id], map: "bundle_events_username_idx")
  @@index([type, to_bundle_id, received_at_ms, id], map: "bundle_events_to_bundle_idx")
  @@index([type, from_bundle_id, received_at_ms, id], map: "bundle_events_from_bundle_idx")
  @@index([type, to_release_id, received_at_ms, id], map: "bundle_events_to_release_idx")
  @@index([type, from_release_id, received_at_ms, id], map: "bundle_events_from_release_idx")
}
model client_access_keys {
  id String @id
  hash String
  name String
  prefix String
  role String
  created_at_ms Float
  revoked_at_ms Float?
  @@unique([hash], map: "client_access_keys_hash_key")
  @@index([created_at_ms, id], map: "client_access_keys_created_at_idx")
}
model private_hot_updater_settings {
  key String @id
  value String @default("1.0.0")
}
// --- END HOT-UPDATER MODELS ---
