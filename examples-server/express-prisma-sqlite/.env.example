# Copy this file to src/.env.hotupdater before starting the server.

PORT=3002
HOT_UPDATER_ADMIN_TOKEN=replace-with-a-long-random-token
# Generate once with `node -e 'console.log(crypto.randomUUID())'` and never rotate for this database.
HOT_UPDATER_INSIGHTS_DATABASE_NAMESPACE=00000000-0000-7000-8000-00000000e001

# Cloudflare R2 / AWS S3 credentials
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
HOT_UPDATER_STORAGE_DOWNLOAD_URL_KEY=replace-with-a-long-random-signing-key
