{
  "name": "@hot-updater/lynx-build",
  "version": "1.0.0-rc.27",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "license": "MIT",
  "repository": "https://github.com/gronxb/hot-updater",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "description": "Framework-independent Lynx build adapter for Hot Updater",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./integration": {
      "import": "./dist/integration.mjs",
      "require": "./dist/integration.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "uuidv7": "catalog:"
  },
  "peerDependencies": {
    "@hot-updater/plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@hot-updater/plugin-core": "workspace:*",
    "@hot-updater/cli-tools": "workspace:*",
    "@types/node": "catalog:"
  }
}
