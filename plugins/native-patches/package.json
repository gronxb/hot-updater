{
  "name": "@hot-updater/native-patches",
  "version": "1.2.0-rc.24",
  "private": true,
  "description": "The edits that make a React Native app's AppDelegate and MainApplication load Hot Updater's bundle, bundled into @hot-updater/expo and @hot-updater/one",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
