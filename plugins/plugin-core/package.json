{
  "name": "@hot-updater/plugin-core",
  "version": "1.0.0-rc.14",
  "type": "module",
  "description": "Engine-neutral plugin contracts for Hot Updater",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./internal": {
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "keywords": ["ota", "over-the-air", "self-hosted"],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "repository": "https://github.com/gronxb/hot-updater",
  "author": "gronxb <gron1gh1@gmail.com> (https://github.com/gronxb)",
  "bugs": {
    "url": "https://github.com/gronxb/hot-updater/issues"
  },
  "homepage": "https://github.com/gronxb/hot-updater#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hot-updater/core": "workspace:*",
    "es-toolkit": "^1.32.0",
    "fast-glob": "3.3.3",
    "mime": "^4.0.4",
    "verkit": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "inlinedDependencies": {
    "verkit": "0.4.0"
  }
}
