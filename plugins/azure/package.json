{
  "name": "@hot-updater/azure",
  "type": "module",
  "version": "1.2.0-rc.8",
  "description": "React Native OTA solution for self-hosted",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./init": {
      "types": "./dist/init/index.d.cts",
      "import": "./dist/init/index.mjs",
      "require": "./dist/init/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": "https://github.com/gronxb/hot-updater",
  "author": "gronxb <gron1gh1@gmail.com> (https://github.com/gronxb)",
  "bugs": {
    "url": "https://github.com/gronxb/hot-updater/issues"
  },
  "homepage": "https://github.com/gronxb/hot-updater#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/core-auth": "catalog:azure",
    "@azure/cosmos": "catalog:azure",
    "@azure/identity": "catalog:azure",
    "@azure/keyvault-secrets": "catalog:azure",
    "@azure/storage-blob": "catalog:azure",
    "@hot-updater/cli-tools": "workspace:*",
    "@hot-updater/plugin-core": "workspace:*",
    "@hot-updater/protocol": "workspace:*",
    "@hot-updater/server": "workspace:*"
  },
  "devDependencies": {
    "@azure/functions": "catalog:azure",
    "@hot-updater/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "execa": "catalog:tools",
    "jszip": "^3.10.1",
    "vitest": "catalog:"
  }
}
