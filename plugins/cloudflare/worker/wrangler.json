{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hot-updater",
  "main": "./dist/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "user-buckets"
    }
  ],
  "vars": {
    "BUCKET_NAME": "user-buckets"
  }
}
