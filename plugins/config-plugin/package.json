{
  "name": "@hot-updater/config-plugin",
  "version": "1.0.8",
  "description": "Hot Updater config plugin for apps whose native projects prebuild generates (Expo, One)",
  "main": "./dist/withHotUpdater.js",
  "types": "./dist/withHotUpdater.d.ts",
  "license": "MIT",
  "repository": "https://github.com/gronxb/hot-updater",
  "author": "gronxb <gron1gh1@gmail.com> (https://github.com/gronxb)",
  "bugs": {
    "url": "https://github.com/gronxb/hot-updater/issues"
  },
  "homepage": "https://github.com/gronxb/hot-updater#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:type": "tsc --noEmit"
  },
  "dependencies": {
    "@hot-updater/cli-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "expo": "^50.0.0",
    "hot-updater": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/withHotUpdater.d.ts",
      "default": "./dist/withHotUpdater.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "expo": ">=50.0.0",
    "hot-updater": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "hot-updater": {
      "optional": true
    }
  }
}
