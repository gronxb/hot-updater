{
  "name": "@hot-updater/analytics",
  "version": "0.35.9",
  "type": "module",
  "description": "Analytics plugin for Hot Updater",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/kysely": {
      "import": {
        "types": "./dist/adapters/kysely.d.mts",
        "default": "./dist/adapters/kysely.mjs"
      },
      "require": {
        "types": "./dist/adapters/kysely.d.cts",
        "default": "./dist/adapters/kysely.cjs"
      }
    },
    "./adapters/mongodb": {
      "import": {
        "types": "./dist/adapters/mongodb.d.mts",
        "default": "./dist/adapters/mongodb.mjs"
      },
      "require": {
        "types": "./dist/adapters/mongodb.d.cts",
        "default": "./dist/adapters/mongodb.cjs"
      }
    },
    "./provider": {
      "import": {
        "types": "./dist/provider/index.d.mts",
        "default": "./dist/provider/index.mjs"
      },
      "require": {
        "types": "./dist/provider/index.d.cts",
        "default": "./dist/provider/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "repository": "https://github.com/gronxb/hot-updater",
  "author": "gronxb <gron1gh1@gmail.com> (https://github.com/gronxb)",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hot-updater/plugin-core": "workspace:*",
    "@hot-updater/server": "workspace:*"
  },
  "peerDependencies": {
    "kysely": "*",
    "mongodb": "*"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:db",
    "@types/node": "catalog:",
    "kysely": "catalog:db",
    "kysely-pglite-dialect": "catalog:db",
    "mongodb": "catalog:db"
  }
}
