generator client {
  provider = "prisma-client-js"
  output   = env("PRISMA_EVIDENCE_CLIENT_OUTPUT")
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model bundle_events {
  id               String  @id @db.Uuid
  type             String
  install_id       String
  user_id          String?
  username         String?
  from_release_id  String? @db.Uuid
  from_bundle_id   String? @db.Uuid
  to_release_id    String? @db.Uuid
  to_bundle_id     String  @db.Uuid
  platform         String
  app_version      String
  channel          String
  cohort           String
  update_strategy  String?
  fingerprint_hash String?
  sdk_version      String?
  received_at_ms   Float
}
