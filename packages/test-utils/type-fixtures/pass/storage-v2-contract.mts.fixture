import type { ConfigResolutionContext } from "@hot-updater/core/config";
import {
  createStoragePlugin,
  type StoragePluginImplementationV2,
  type StoragePluginV2,
} from "@hot-updater/plugin-core";
import type {
  FeatureInvocationMap,
  HotUpdaterFeatureInvocation,
  InvocationAwareFeatureValue,
  RuntimeStorageAccess,
  StorageInvocationToken,
} from "@hot-updater/plugin-core";
import {
  StoragePluginError,
  type StorageByteRange,
  type StorageContentRange,
  type StorageDeleteResult,
  type StorageGetResult,
  type StorageHeadResult,
  type StorageIssueDownloadResult,
  type StorageListResult,
  type StorageObjectMetadata,
  type StorageOperationContext,
  type StoragePlugin,
  type StoragePluginErrorCode,
  type StoragePluginImplementation,
  type StoragePutResult,
} from "@hot-updater/plugin-core/storage";

type Bindings = {
  readonly bucket: {
    value: number;
    increment(): number;
  };
};

declare const configContext: ConfigResolutionContext<Bindings>;
const storageContext: StorageOperationContext<Bindings> = configContext;
const metadata: StorageObjectMetadata = {
  contentLength: 3,
  contentType: "application/octet-stream",
  custom: { checksum: "abc" },
  etag: "etag",
  lastModified: "2026-07-26T00:00:00.000Z",
};
const byteRange: StorageByteRange = { start: 0, end: 2 };
const contentRange: StorageContentRange = {
  start: 0,
  end: 2,
  totalLength: 3,
};

const implementation: StoragePluginImplementation<
  StorageOperationContext<Bindings>
> = {
  async put(input): Promise<StoragePutResult> {
    input.context.bindings.bucket.increment();
    input.signal?.throwIfAborted();
    return { kind: "stored", storageUri: `memory://${input.key}` };
  },
  async head(input): Promise<StorageHeadResult> {
    return input.storageUri.length > 0
      ? { kind: "found", storageUri: input.storageUri, metadata }
      : { kind: "not-found" };
  },
  async get(input): Promise<StorageGetResult> {
    return {
      kind: "found",
      storageUri: input.storageUri,
      body: new ReadableStream<Uint8Array>(),
      metadata,
      range: contentRange,
    };
  },
  async delete(input): Promise<StorageDeleteResult> {
    return input.storageUri.length > 0
      ? { kind: "deleted" }
      : { kind: "not-found" };
  },
  async issueDownload(input): Promise<StorageIssueDownloadResult> {
    return {
      kind: "issued",
      downloadUrl: input.storageUri,
      expiresAt: "2026-07-26T00:00:00.000Z",
    };
  },
  async list(input): Promise<StorageListResult> {
    return {
      objects: [
        {
          key: input.prefix ?? "bundle",
          storageUri: "memory://bundle",
          metadata,
        },
      ],
    };
  },
  async onUnmount(): Promise<void> {},
};

const plugin: StoragePlugin<StorageOperationContext<Bindings>> = {
  name: "memory",
  protocol: "memory",
  ...implementation,
};
const rootPlugin: StoragePluginV2<StorageOperationContext<Bindings>> = plugin;
const rootImplementation: StoragePluginImplementationV2<
  StorageOperationContext<Bindings>
> = implementation;
const factoryType: typeof createStoragePlugin = createStoragePlugin;

await plugin.put({
  key: "bundle",
  body: new Uint8Array([1, 2, 3]),
  contentLength: 3,
  context: storageContext,
  condition: "create-only",
  metadata: { checksum: "abc" },
  signal: new AbortController().signal,
});
await plugin.put({
  key: "stream",
  body: new ReadableStream<Uint8Array>(),
  contentLength: 0,
  context: storageContext,
});
await plugin.head({ context: storageContext, storageUri: "memory://bundle" });
await plugin.get({
  context: storageContext,
  storageUri: "memory://bundle",
  range: byteRange,
});
await plugin.delete({
  context: storageContext,
  storageUri: "memory://bundle",
});
await plugin.issueDownload?.({
  context: storageContext,
  storageUri: "memory://bundle",
  expiresInSeconds: 60,
});
await plugin.list?.({ context: storageContext, limit: 10, prefix: "bundles/" });

const error = new StoragePluginError("provider", "provider failed", {
  cause: new TypeError("cause"),
});
const errorCode: StoragePluginErrorCode = error.code;

type PublicFeature = Readonly<{
  overview(): Promise<string>;
  summary(bundleId: string, context?: { readonly requestId: string }): string;
  label: string;
}>;

const rawFeature: InvocationAwareFeatureValue<
  PublicFeature,
  { readonly requestId: string }
> = {
  overview: async () => "ok",
  summary: (bundleId, context, invocation) =>
    `${bundleId}:${context?.requestId}:${invocation?.platformContext?.requestId}`,
  label: "feature",
};
const shorterRawFeature: InvocationAwareFeatureValue<
  PublicFeature,
  { readonly requestId: string }
> = {
  overview: async () => "ok",
  summary: (bundleId) => bundleId,
  label: "short",
};
const invocationMap: FeatureInvocationMap = {
  overview: { publicArity: 1, contextIndex: 0 },
  summary: { publicArity: 2, contextIndex: 1 },
};

declare const storageAccess: RuntimeStorageAccess;
declare const storageToken: StorageInvocationToken;
declare const invocation: HotUpdaterFeatureInvocation<{
  readonly requestId: string;
}>;
await storageAccess.readText("memory://bundle", storageToken);
await storageAccess.getDownloadUrl("memory://bundle", invocation.storageToken);

void rootPlugin;
void rootImplementation;
void factoryType;
void errorCode;
void rawFeature;
void shorterRawFeature;
void invocationMap;
