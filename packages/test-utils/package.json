{
  "name": "@hot-updater/test-utils",
  "version": "1.0.0-rc.32",
  "type": "module",
  "description": "Test utilities for Hot Updater packages",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native.d.mts",
        "default": "./dist/react-native.mjs"
      },
      "require": {
        "types": "./dist/react-native.d.cts",
        "default": "./dist/react-native.cjs"
      }
    },
    "./package.json": "./package.json",
    "./fixtures/lynx/catalog-policy.json": "./fixtures/lynx/catalog-policy.json",
    "./fixtures/lynx/manifest-v1-bulk.json": "./fixtures/lynx/manifest-v1-bulk.json"
  },
  "files": [
    "dist",
    "package.json",
    "fixtures/lynx"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "repository": "https://github.com/gronxb/hot-updater",
  "author": "gronxb <gron1gh1@gmail.com> (https://github.com/gronxb)",
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "@hot-updater/plugin-insights": "workspace:^",
    "@hot-updater/protocol": "workspace:^",
    "@hot-updater/plugin-core": "workspace:^",
    "@hot-updater/server": "workspace:^",
    "execa": "*",
    "mysql2": "*",
    "pg": "*",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@hot-updater/plugin-insights": {
      "optional": true
    },
    "@hot-updater/server": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:db",
    "@hot-updater/plugin-insights": "workspace:*",
    "@hot-updater/protocol": "workspace:*",
    "@hot-updater/js": "workspace:*",
    "@hot-updater/plugin-core": "workspace:*",
    "@hot-updater/server": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "execa": "catalog:tools",
    "@typescript/native": "npm:typescript@7.0.2",
    "mysql2": "catalog:db",
    "pg": "catalog:db",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "catalog:",
    "workspace-tools": "^0.41.7"
  },
  "inlinedDependencies": {
    "@nodelib/fs.scandir": "2.1.5",
    "@nodelib/fs.stat": "2.0.5",
    "@nodelib/fs.walk": "1.2.8",
    "@yarnpkg/lockfile": "1.1.0",
    "braces": "3.0.3",
    "fast-glob": "3.3.3",
    "fastq": "1.20.1",
    "fill-range": "7.1.1",
    "git-up": "8.1.1",
    "git-url-parse": "16.1.0",
    "glob-parent": "5.1.2",
    "is-extglob": "2.1.1",
    "is-glob": "4.0.3",
    "is-number": "7.0.0",
    "is-ssh": "1.4.1",
    "jju": "1.4.0",
    "js-yaml": "4.2.0",
    "merge2": "1.4.1",
    "micromatch": "4.0.8",
    "parse-path": "7.1.0",
    "parse-url": "9.2.0",
    "picomatch": "2.3.2",
    "protocols": "2.0.2",
    "queue-microtask": "1.2.3",
    "reusify": "1.1.0",
    "run-parallel": "1.2.0",
    "to-regex-range": "5.0.1",
    "workspace-tools": "0.41.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
