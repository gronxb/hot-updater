  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:type": "tsc --noEmit"
  },
  "description": "Sparkling host integration for Hot Updater Lynx",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "android",
    "ios",
    "README.md",
    "!**/build",
