{
  "name": "@hot-updater/lynx-sparkling",
  "version": "1.0.0-rc.27",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
